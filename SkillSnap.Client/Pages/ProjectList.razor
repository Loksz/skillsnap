@page "/projects"
@inject ProjectService ProjectService
@inject UserSessionService Session

<h2>Projects</h2>

@if (_loading)
{
    <p>Loading projects...</p>
}
else if (_projects.Count == 0)
{
    <p>No projects found. <a href="/seed">Seed sample data</a> first.</p>
}
else
{
    <div class="project-grid">
        @foreach (var p in _projects)
        {
            <div class="project-card">
                <img src="@p.ImageUrl" alt="@p.Title" />
                <h3>@p.Title</h3>
                <p>@p.Description</p>
                @if (Session.IsAdmin)
                {
                    <button class="btn-delete" @onclick="() => DeleteProject(p.Id)">Delete</button>
                }
            </div>
        }
    </div>
}

@if (Session.IsLoggedIn)
{
    <hr />
    <h3>Add Project</h3>
    <div class="form-group">
        <input @bind="_newTitle"       placeholder="Title"       />
        <input @bind="_newDescription" placeholder="Description" />
        <input @bind="_newImageUrl"    placeholder="Image URL"   />
        <button @onclick="AddProject">Add</button>
        @if (!string.IsNullOrEmpty(_message))
        {
            <span class="msg">@_message</span>
        }
    </div>
}

@code {
    private List<ProjectDto> _projects = new();
    private bool   _loading        = true;
    private string _newTitle       = string.Empty;
    private string _newDescription = string.Empty;
    private string _newImageUrl    = string.Empty;
    private string _message        = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _projects = await ProjectService.GetProjectsAsync();
        _loading  = false;
    }

    private async Task AddProject()
    {
        if (string.IsNullOrWhiteSpace(_newTitle)) return;

        var ok = await ProjectService.AddProjectAsync(new ProjectDto
        {
            Title           = _newTitle,
            Description     = _newDescription,
            ImageUrl        = _newImageUrl,
            PortfolioUserId = 1
        });

        _message  = ok ? "Project added!" : "Error adding project.";
        if (ok) { _projects = await ProjectService.GetProjectsAsync(); _newTitle = _newDescription = _newImageUrl = ""; }
    }

    private async Task DeleteProject(int id)
    {
        var ok = await ProjectService.DeleteProjectAsync(id);
        if (ok) _projects = await ProjectService.GetProjectsAsync();
    }
}

<style>
    .project-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem; }
    .project-card { border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; }
    .project-card img  { width: 100%; height: 160px; object-fit: cover; }
    .project-card h3, .project-card p { padding: 0 1rem; }
    .btn-delete { margin: .5rem 1rem 1rem; background: #fee2e2; color: #991b1b; border: none; border-radius: 4px; padding: .3rem .7rem; cursor: pointer; }
    .form-group input { display: block; margin: .4rem 0; padding: .4rem; width: 100%; max-width: 400px; border: 1px solid #d1d5db; border-radius: 4px; }
    .msg { color: #065f46; font-size: .9rem; }
</style>
