@page "/login"
@inject AuthService AuthService
@inject NavigationManager Nav

<div class="auth-form">
    <h2>Sign In</h2>

    <input @bind="_email"    placeholder="Email"    type="email"    />
    <input @bind="_password" placeholder="Password" type="password" />
    <button @onclick="HandleLogin">Login</button>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error">@_error</p>
    }

    <p>Don't have an account? <a href="/register">Register</a></p>
</div>

@code {
    private string _email    = string.Empty;
    private string _password = string.Empty;
    private string _error    = string.Empty;

    private async Task HandleLogin()
    {
        _error = string.Empty;
        var ok = await AuthService.LoginAsync(_email, _password);
        if (ok)
            Nav.NavigateTo("/projects");
        else
            _error = "Invalid email or password.";
    }
}

<style>
    .auth-form { max-width: 360px; margin: 3rem auto; padding: 2rem; border: 1px solid #e5e7eb; border-radius: 8px; }
    .auth-form h2 { margin-bottom: 1.5rem; }
    .auth-form input { display: block; width: 100%; margin: .5rem 0; padding: .5rem; border: 1px solid #d1d5db; border-radius: 4px; }
    .auth-form button { width: 100%; padding: .6rem; margin-top: .8rem; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; }
    .error { color: #dc2626; font-size: .9rem; }
</style>
